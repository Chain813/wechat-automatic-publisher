# ============================================
# AutoWeChat 环境配置模板
# 必填：微信公众号与写作模型凭据
# ============================================

# 1. 微信公众号（必填 · 发布）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 公众号名称、作者与文末落款（可选，作者留空时使用公众号名称）
# BRAND_NAME=极研JiYan
# ARTICLE_AUTHOR=
# ARTICLE_SIGNATURE=**关注「极研JiYan」，只讲有出处的科技门道与深度拆解。**

# 2. DeepSeek（必填 · 写作）
LLM_API_KEY=
# 多 Key 轮询（可选 · 逗号分隔，限流/欠费自动切换）：
# LLM_API_KEYS=sk-key1,sk-key2
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-flash
# 三段式热点引擎：原生联网深调研 + 主笔模型纯写作 + 轻排版（可选覆盖）
# LLM_RESEARCH_MODEL=deepseek-flash
# LLM_WRITER_MODEL=deepseek-v4-pro
# LLM_WRITER_REASONING_EFFORT=low
# LLM_ENABLE_WEB_SEARCH=True
# LLM_MAX_TOKENS=16384
# LLM_ENABLE_THINKING=False

# 3. Google Gemini Nano Banana（首选 AI 生图）与 DashScope 千问（降级备选 / 识图）
IMAGE_PROVIDER=auto
IMAGE_GEN_MODEL=gemini-nano-banana-2.1
# 云端服务器推荐仅配置私有生图服务端点 + Token（免在境内服务器存放 GEMINI_API_KEY）：
# GEMINI_IMAGE_SERVICE_URL=https://gemini.239020.xyz/api/generate
# GEMINI_PROXY_TOKEN=
# 直连海外或本地开发也可直接填写 GEMINI_API_KEY（未设 GEMINI_IMAGE_SERVICE_URL 时生效）：
GEMINI_API_KEY=
# GEMINI_API_KEYS=key1,key2
# GEMINI_API_BASE=https://generativelanguage.googleapis.com
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# GEMINI_IMAGE_SIZE=1K
# GEMINI_IMAGE_BODY_ASPECT_RATIO=16:9
# GEMINI_IMAGE_COVER_ASPECT_RATIO=21:9
# GEMINI_IMAGE_THINKING_LEVEL=minimal
# GEMINI_IMAGE_FALLBACK_TO_QWEN=True

DASHSCOPE_API_KEY=
# 多 Key 轮询（可选 · 逗号分隔；不同账号的 Key 可叠加提升 QPM 并发上限）：
# DASHSCOPE_API_KEYS=sk-key1,sk-key2
# QWEN_IMAGE_MODEL=qwen-image-3.0
# QWEN_IMAGE_REDRAW_MODEL=qwen-image-3.0-pro
# QWEN_VL_MODEL=qwen-vl-max
# QWEN_IMAGE_SIZE=1280*720
# MAX_AI_IMAGES_PER_ARTICLE=1
# QWEN_IMAGE_DAILY_LIMIT=6

# 企业微信通知（可选）
QYWECHAT_WEBHOOK=

# GitHub API 可选令牌（提高检索限额，不填亦可抓取 Trending）
# GITHUB_TOKEN=

# 本地 Stable Diffusion（可选 · 备选生图服务）
# SD_ENABLED=True
# SD_API_URL=http://127.0.0.1:7860

# 事实核查与并发控制（可选）
# ENABLE_FACT_SEARCH=True
# MAX_FACT_SNIPPETS=4
# DIAGRAM_PARALLEL_WORKERS=5

# WebUI 安全与云端模式（可选）
# WEBUI_TOKEN=
# CLOUD_MODE=

# 高级
# NEWS_FRESHNESS_HOURS=24
# LLM_TEMPERATURE=0.75
# HOTSPOT_CACHE_TTL_SECONDS=60
# MAX_TOPICS_PER_RUN=1
# MAX_AIKEPU_PER_RUN=1
# KNOWLEDGE_TREE=aikepu
