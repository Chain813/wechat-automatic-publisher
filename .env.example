# ============================================
# AutoWeChat 环境配置模板
# 必填仅 3 项：微信公众号 + DeepSeek + DashScope 千问
# ============================================

# 1. 微信公众号（必填 · 发布）
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 2. DeepSeek（必填 · 写作）
LLM_API_KEY=
# 多 Key 轮询（可选 · 逗号分隔，限流/欠费自动切换）：
# LLM_API_KEYS=sk-key1,sk-key2
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# 3. DashScope 千问（必填 · 一个 Key 覆盖生图 + 识图）
DASHSCOPE_API_KEY=
# 多 Key 轮询（可选 · 逗号分隔；不同账号的 Key 可叠加提升 QPM 并发上限）：
# DASHSCOPE_API_KEYS=sk-key1,sk-key2
# QWEN_IMAGE_MODEL=qwen-image-3.0
# QWEN_IMAGE_REDRAW_MODEL=qwen-image-3.0-pro
# QWEN_VL_MODEL=qwen-vl-max
# QWEN_IMAGE_SIZE=1280*720

# 企业微信通知（可选）
QYWECHAT_WEBHOOK=

# 本地 Stable Diffusion（可选 · 本地服务）
# SD_ENABLED=True
# SD_API_URL=http://127.0.0.1:7860

# 高级
# NEWS_FRESHNESS_HOURS=24
# LLM_TEMPERATURE=0.75
# HOTSPOT_CACHE_TTL_SECONDS=600
# KNOWLEDGE_TREE=aikepu
